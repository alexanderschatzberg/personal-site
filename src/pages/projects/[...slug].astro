---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Demo from '../../components/Demo.astro';
import { getProjects, projectHasPage, inlineLinks, plainText } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter(projectHasPage)
    .map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, image, imageAlt, url, demo } = project.data;
---
<Base title={title} description={plainText(description)} path="projects">
  <article class="essay">
    <header class="essay-header">
      <h1>{title}</h1>
      <p class="essay-subtitle" set:html={inlineLinks(description)} />
      {url && <a class="muted" href={url}>{url} ↗</a>}
    </header>
    {demo
      ? <Demo name={demo} poster={image} alt={imageAlt} />
      : image && <img class="project-hero" src={image} alt={imageAlt ?? ''} />}
    <div class="prose"><Content /></div>
    <footer class="essay-footer">
      <a href="/projects/">← all projects</a>
    </footer>
  </article>
</Base>
