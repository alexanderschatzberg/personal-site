---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';

// Drop a photo at public/images/me.jpg and it shows up here.
const photo = '/images/me.jpg';
const hasPhoto = existsSync(new URL('../../public' + photo, import.meta.url));
---
<Base title="About" path="about">
  <div class="about">
    {hasPhoto
      ? <img class="about-photo" src={photo} alt="Zander Schatzberg" />
      : <div class="about-photo image-placeholder" aria-hidden="true">[photo]</div>}
    <div class="prose">
      <h1 class="page-title">About</h1>
      <p>[Write about yourself here.]</p>
    </div>
  </div>
</Base>
