---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getEssays, formatDate, readingTime } from '../../lib';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay, i) => ({
    params: { slug: essay.id },
    props: { essay, next: essays[i + 1] }, // next = the older post
  }));
}

const { essay, next } = Astro.props;
const { Content } = await render(essay);
const { title, subtitle, date } = essay.data;
---
<Base title={title} description={subtitle} path="writing">
  <article class="essay">
    <header class="essay-header">
      <span class="muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(essay.body)} min read
      </span>
      <h1>{title}</h1>
      {subtitle && <p class="essay-subtitle">{subtitle}</p>}
    </header>
    <div class="prose"><Content /></div>
    <footer class="essay-footer">
      <a href="/writing/">← all writing</a>
      {next && <a href={`/writing/${next.id}/`}>{next.data.title} →</a>}
    </footer>
  </article>
</Base>
